# Redirect root to default locale
/  /en/  301

# 旧 URL → 新 slug（xeviora 注册表权威 slug）
/:locale/portfolios/showcase/svg-grabber/*  /:locale/portfolios/svg-forge/  301
/:locale/portfolios/showcase/xeviora-svg/*  /:locale/portfolios/svg-forge/  301

# showcase 层级已拍平：/portfolios/showcase/<slug> → /portfolios/<slug>
# 必须排在上面两条之后（_redirects 先匹配先生效），同时覆盖详情页与 /privacy 子页
/:locale/portfolios/showcase/*  /:locale/portfolios/:splat  301

# more 页已并入主作品集网格
/:locale/portfolios/more/  /:locale/portfolios/  301

# 博客是单语英文：其余语言的 /blog 一律 301 到英文版
# （配合 scripts/prune-blog-locales.mjs 删除这些语言下的静态产物）
/zh-cn/blog  /en/blog/  301
/zh-cn/blog/*  /en/blog/:splat  301
/zh-tw/blog  /en/blog/  301
/zh-tw/blog/*  /en/blog/:splat  301
/es/blog  /en/blog/  301
/es/blog/*  /en/blog/:splat  301
/fr/blog  /en/blog/  301
/fr/blog/*  /en/blog/:splat  301
/ja/blog  /en/blog/  301
/ja/blog/*  /en/blog/:splat  301
